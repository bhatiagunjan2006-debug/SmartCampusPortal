@model ServiceRequest
@{
    ViewData["Title"] = "Create Request";
}

<div class="row justify-content-center">
    <div class="col-xl-8">
        <div class="card-panel">
            <h4 class="mb-1">Submit New Service Request</h4>
            <p class="text-muted">Status will be set to <span class="badge status-badge badge-pending">Pending</span> and the date/time is recorded automatically.</p>

            <form asp-action="Create" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="StudentName" class="form-label"></label>
                        <input asp-for="StudentName" class="form-control" placeholder="e.g. Gunjan Bhatia" />
                        <span asp-validation-for="StudentName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Department" class="form-label"></label>
                        <input asp-for="Department" class="form-control" list="deptList" placeholder="e.g. Computer Science & Engineering" />
                        <datalist id="deptList">
                            @foreach (var d in Lookups.Departments) { <option value="@d"></option> }
                        </datalist>
                        <span asp-validation-for="Department" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ServiceType" class="form-label"></label>
                        <select asp-for="ServiceType" class="form-select" asp-items="@(new SelectList(Lookups.ServiceTypes))">
                            <option value="">-- Select service type --</option>
                        </select>
                        <span asp-validation-for="ServiceType" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Priority" class="form-label"></label>
                        <select asp-for="Priority" class="form-select" asp-items="@(new SelectList(Lookups.Priorities))"></select>
                        <span asp-validation-for="Priority" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Describe your request clearly..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-teal px-4"><i class="bi bi-send me-1"></i> Submit Request</button>
                    <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
