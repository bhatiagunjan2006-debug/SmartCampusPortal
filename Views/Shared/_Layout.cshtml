@{
    bool landing = ViewData["Landing"] as bool? ?? false;
    string ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    string act = ViewContext.RouteData.Values["action"]?.ToString();
    string Active(string c, string a) => (c == ctrl && a == act) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Marwadi University Smart Campus Portal</title>
    <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="@(landing ? "landing-body" : "app-body")">

@if (landing)
{
    <nav class="navbar navbar-expand-lg navbar-dark landing-nav fixed-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                <span class="logo-box">MU</span>
                <span class="lh-1"><strong>MARWADI UNIVERSITY</strong><br /><small class="opacity-75">Smart Campus Service Portal</small></span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#topNav"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="topNav">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Dashboard">Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="ServiceRequest" asp-action="Index">All Requests</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="ServiceRequest" asp-action="Track">Track</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="ApiInfo">API</a></li>
                    <li class="nav-item"><a class="btn btn-light btn-sm fw-semibold px-3" asp-controller="ServiceRequest" asp-action="Create">Submit Request</a></li>
                </ul>
            </div>
        </div>
    </nav>

    @RenderBody()

    <footer class="landing-footer text-center">
        <div class="container">
            <strong>MARWADI UNIVERSITY</strong> &middot; Smart Campus Service Portal<br />
            <small>One Campus. Every Service. One Platform. &copy; @DateTime.Now.Year Marwadi University, Rajkot</small>
        </div>
    </footer>
}
else
{
    <div class="app-shell">
        <aside class="sidebar" id="sidebar">
            <a class="sidebar-brand" asp-controller="Home" asp-action="Index">
                <span class="logo-box">MU</span>
                <span class="lh-1"><strong>MARWADI<br />UNIVERSITY</strong></span>
            </a>
            <div class="sidebar-sub">Smart Campus Service Portal</div>
            <nav class="sidebar-nav">
                <a class="@Active("Home","Dashboard")" asp-controller="Home" asp-action="Dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a>
                <a class="@Active("ServiceRequest","Create")" asp-controller="ServiceRequest" asp-action="Create"><i class="bi bi-plus-circle"></i> Create Request</a>
                <a class="@Active("ServiceRequest","Index")" asp-controller="ServiceRequest" asp-action="Index"><i class="bi bi-list-ul"></i> All Requests</a>
                <a class="@Active("ServiceRequest","Track")" asp-controller="ServiceRequest" asp-action="Track"><i class="bi bi-geo-alt"></i> Track Requests</a>
                <a class="@Active("Home","ApiInfo")" asp-controller="Home" asp-action="ApiInfo"><i class="bi bi-code-slash"></i> API Information</a>
                <a class="@Active("Home","About")" asp-controller="Home" asp-action="About"><i class="bi bi-building"></i> About Campus</a>
            </nav>
            <div class="sidebar-foot">One Campus.<br />Every Service.<br />One Platform.</div>
        </aside>

        <div class="main-area">
            <header class="topbar">
                <button class="btn btn-sm btn-outline-secondary d-lg-none" id="sidebarToggle" type="button"><i class="bi bi-list fs-5"></i></button>
                <div class="topbar-title">@ViewData["Title"]</div>
                <a class="btn btn-teal btn-sm ms-auto" asp-controller="ServiceRequest" asp-action="Create"><i class="bi bi-plus-lg"></i> New Request</a>
            </header>

            <main class="content">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show auto-dismiss" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @RenderBody()
            </main>

            <footer class="app-footer">
                <strong>MARWADI UNIVERSITY</strong> &middot; Smart Campus Service Portal &middot; One Campus. Every Service. One Platform.
                <span class="d-block d-md-inline">&copy; @DateTime.Now.Year</span>
            </footer>
        </div>
    </div>
}

    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
